# ORIG [0001]: # Level description file:
# Level description file:
# ORIG [0002]: # Each line has six fields: kind, startx, starty, endx, endy, type
# Each line has six fields: kind, startx, starty, endx, endy, type
# ORIG [0003]: # is a comment line
# is a comment line
# ORIG [0004]:

# ORIG [0005]: # kind: 1 = straight wall
# kind: 1 = straight wall
# ORIG [0006]: #       2 = arc (not implemented yet)
#       2 = arc (not implemented yet)
# ORIG [0007]: #    3 = door (startx,starty are left/top of door)
#    3 = door (startx,starty are left/top of door)
# ORIG [0008]: #       5 = filled block
#       5 = filled block
# ORIG [0009]: #    6 = filled ellipse (endx/endy are rx/ry)
#    6 = filled ellipse (endx/endy are rx/ry)
# ORIG [0010]: #    7 = spiral stairs (startx/starty are center)
#    7 = spiral stairs (startx/starty are center)
# ORIG [0011]: #    8 = toilet (hey, there are a lot)
#    8 = toilet (hey, there are a lot)
# ORIG [0012]: #       9 = text (endx is text to print, endy is "b" for bold, type is size)
#       9 = text (endx is text to print, endy is "b" for bold, type is size)
# ORIG [0013]: #      99 = continuation of previous (useful for blocks)
#      99 = continuation of previous (useful for blocks)
# ORIG [0014]:

# ORIG [0015]: # Type for lines
# Type for lines
# ORIG [0016]: # type: 1 = normal
# type: 1 = normal
# ORIG [0017]: #       2 = thick
#       2 = thick
# ORIG [0018]: #       3 = dashed
#       3 = dashed
# ORIG [0019]: #       4 = dotted
#       4 = dotted
# ORIG [0020]: #       5 = thin
#       5 = thin
# ORIG [0021]:

# ORIG [0022]: # Type for fill
# Type for fill
# ORIG [0023]: # type: 1 = solid
# type: 1 = solid
# ORIG [0024]: #       2 = white
